# Required: absolute path of the folder that contains the compose projects
PROJECTS_ROOT=/opt/stacks
# Only for plain http: URL Dockit is opened with, otherwise form submissions fail with 403.
# Leave it unset behind an https reverse proxy like Caddy.
# ORIGIN=http://server:3000

# Optional: data folder (sqlite db + config.json). Defaults to ./data, in docker to /data
# (keep it unset there, compose mounts ./data:/data)
# DOCKIT_DATA_DIR=./data

# Optional: host path of the docker socket. Set it for rootless docker,
# e.g. /run/user/1000/docker.sock (see `docker context inspect`)
# DOCKER_SOCKET=/var/run/docker.sock

# Optional: max. request size, limits file uploads in the Files tab (default in docker: 1G)
# BODY_SIZE_LIMIT=1G
