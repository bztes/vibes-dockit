# Required: absolute path of the folder that contains the compose projects
PROJECTS_ROOT=/opt/stacks
# URL Dockit is opened with. Needed for plain http (e.g. http://server:3000), otherwise
# form submissions fail with 403. Can be left out behind an https reverse proxy like Caddy.
ORIGIN=http://localhost:3000

# Optional: data folder (sqlite db + config.json). Defaults to ./data, in docker to /data
# (keep it unset there, compose mounts ./data:/data)
# DOCKIT_DATA_DIR=./data
